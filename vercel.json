{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v/:code",
      "destination": "/download"
    }
  ],
  "redirects": [
    {
      "source": "/baixar",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/en/baixar",
      "destination": "/en/download",
      "permanent": true
    }
  ]
}
