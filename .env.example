# Optional overrides for the store links (see src/data/stores.ts). Left empty, the App Store button uses the app's own
# listing and the Google Play button renders as "Em breve" / "Coming soon" until the Android app is published.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=

# Shared links (/v/<code> and the report form): the Edge Functions base URL and the publishable key (both public) of
# the project the links come from. Unset, the site reads the development project (reprize-dev).
#   SHARE_API_BASE=https://<prod ref>.supabase.co/functions/v1
SHARE_API_BASE=
SHARE_API_KEY=
# Production only: the development project, so the team's test links keep opening on the same domain.
SHARE_FALLBACK_API_BASE=
SHARE_FALLBACK_API_KEY=
