# Store links shown on the landing page. While empty, the buttons render as "Em breve" / "Coming soon".
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=

# Shared-link page (/v/<code>): the public Supabase function and the publishable key of the project it reads.
# Unset, the page uses the development project (reprize-dev). Set both for production.
SHARE_PAGE_API=
SHARE_PAGE_KEY=
