---
import StoreButton from './store-button.astro';
import { APP_STORE_URL, PLAY_STORE_URL } from '../data/stores';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);

const appStoreUrl = APP_STORE_URL;
const playStoreUrl = PLAY_STORE_URL || undefined;
---

<div class:list={['flex flex-wrap gap-3', className]}>
  <StoreButton
    icon="apple"
    store={t('store.appStore')}
    href={appStoreUrl}
    soonLabel={t('store.soon')}
    availableLabel={t('store.availableOn')}
  />
  <StoreButton
    icon="play"
    store={t('store.googlePlay')}
    href={playStoreUrl}
    soonLabel={t('store.soon')}
    availableLabel={t('store.availableOn')}
  />
</div>
