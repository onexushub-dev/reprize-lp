---
import '../styles/home.css';
import BaseLayout from '../layouts/base-layout.astro';
import BrandLogo from './brand-logo.astro';
import StoreButton from './store-button.astro';
import { SOCIAL_LINKS, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// This page is the target of the QR code on printed material, so the iPhone link cannot depend on the environment:
// without PUBLIC_APP_STORE_URL it falls back to the App Store listing by id, which opens in the visitor's own country.
const appStoreUrl = import.meta.env.PUBLIC_APP_STORE_URL || 'https://apps.apple.com/app/id6833159162';
// Empty until the Android app is published. Once set, Android phones are sent to Google Play like iPhones to the App Store.
const playStoreUrl = import.meta.env.PUBLIC_PLAY_STORE_URL || '';

const eyebrow = 'text-amber text-xs font-bold tracking-[0.24em] uppercase sm:text-sm';
const title = 'mt-4 text-5xl font-extrabold sm:text-7xl';
const body = 'text-paper/80 mx-auto mt-5 max-w-md text-base leading-7 sm:text-lg sm:leading-8';
---

<BaseLayout locale={locale} title={t('download.metaTitle')} description={t('download.metaDescription')} slug="baixar" noindex>
  <!-- Runs before the content below is painted: marks the phone's system on <html> and sends it to its store. -->
  <script is:inline define:vars={{ appStoreUrl, playStoreUrl }}>
    var ua = navigator.userAgent;
    // iPadOS reports itself as a Mac, so a Mac with a touch screen counts as iOS.
    var ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    var android = !ios && /Android/i.test(ua);
    if (ios) document.documentElement.dataset.platform = 'ios';
    if (android) document.documentElement.dataset.platform = 'android';
    var store = ios ? appStoreUrl : android ? playStoreUrl : '';
    // replace(), so the back button does not land on this page and bounce to the store again.
    if (store) location.replace(store);
  </script>

  <section class="hero-glow grain relative isolate overflow-hidden">
    <div class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-4 py-16 text-center sm:px-6 sm:py-24">
      <BrandLogo name="simbolo" width={71} height={48} class="h-12 w-auto" />

      <!-- Computers and anything else: both stores. Also what shows without JavaScript. -->
      <div data-platform-view="other" class="mt-8">
        <p class={eyebrow}>{t('download.eyebrow')}</p>
        <h1 class={title}>{t('download.title')}</h1>
        <p class={body}>{t('download.body')}</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <StoreButton icon="apple" store={t('store.appStore')} href={appStoreUrl} soonLabel={t('store.soon')} availableLabel={t('store.availableOn')} />
          <StoreButton icon="play" store={t('store.googlePlay')} href={playStoreUrl || undefined} soonLabel={t('store.soon')} availableLabel={t('store.availableOn')} />
        </div>
      </div>

      <!-- iPhone and iPad: already on the way to the App Store; the button is there if the store does not open. -->
      <div data-platform-view="ios" class="mt-8">
        <p class={eyebrow}>{t('download.iosEyebrow')}</p>
        <h1 class={title}>{t('download.openingAppStore')}</h1>
        <p class={body}>{t('download.openingHint')}</p>
        <div class="mt-9 flex justify-center">
          <StoreButton icon="apple" store={t('store.appStore')} href={appStoreUrl} soonLabel={t('store.soon')} availableLabel={t('store.availableOn')} />
        </div>
      </div>

      <!-- Android: "coming soon" until the Google Play link exists, then the same as iPhone. -->
      <div data-platform-view="android" class="mt-8">
        {
          playStoreUrl ? (
            <>
              <p class={eyebrow}>{t('download.androidEyebrow')}</p>
              <h1 class={title}>{t('download.openingPlay')}</h1>
              <p class={body}>{t('download.openingHint')}</p>
              <div class="mt-9 flex justify-center">
                <StoreButton icon="play" store={t('store.googlePlay')} href={playStoreUrl} soonLabel={t('store.soon')} availableLabel={t('store.availableOn')} />
              </div>
            </>
          ) : (
            <>
              <p class={eyebrow}>{t('download.androidEyebrow')}</p>
              <h1 class={title}>
                <span class="text-amber block">{t('download.soonTitle')}</span>
                <span class="block">{t('download.soonTitleRest')}</span>
              </h1>
              <p class={body}>{t('download.soonBody')}</p>
              <div class="mt-9 flex flex-col items-center gap-4">
                <StoreButton icon="play" store={t('store.googlePlay')} soonLabel={t('store.soon')} availableLabel={t('store.availableOn')} />
                <a
                  href={SOCIAL_LINKS.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-line hover:border-amber hover:text-amber inline-flex min-h-[52px] items-center gap-3 rounded-2xl border px-5 py-2 font-bold transition-colors"
                >
                  <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
                  </svg>
                  {t('download.soonFollow')}
                </a>
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* One view per system, picked by the attribute the script above sets on <html>. */
  [data-platform-view='ios'],
  [data-platform-view='android'],
  html[data-platform] [data-platform-view='other'] {
    display: none;
  }

  html[data-platform='ios'] [data-platform-view='ios'],
  html[data-platform='android'] [data-platform-view='android'] {
    display: block;
  }
</style>
