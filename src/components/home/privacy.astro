---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = homeCopy[locale].privacy;
---

<section id="privacy" class="mx-auto max-w-6xl scroll-mt-8 px-4 py-16 sm:px-6 sm:py-24">
  <div class="border-line bg-surface/60 rounded-[1.75rem] border p-6 sm:p-10">
    <div class="grid items-center gap-8 lg:grid-cols-[1.25fr_0.75fr] lg:gap-14">
      <div>
        <p class="text-amber reveal text-xs font-bold tracking-[0.24em] uppercase sm:grid-cols-3 sm:text-sm">{c.eyebrow}</p>
        <h2 class="reveal mt-3 text-4xl font-extrabold sm:text-5xl">{c.title}</h2>
        <p class="text-paper/80 reveal mt-5 max-w-xl text-lg leading-8">{c.body}</p>
      </div>

      <div>
        <ul class="grid gap-3">
          {
            c.bullets.map((b) => (
              <li class="reveal flex items-start gap-3 font-semibold">
                <svg viewBox="0 0 24 24" class="text-amber mt-0.5 size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
                {b}
              </li>
            ))
          }
        </ul>
        <a href={getRelativeLocaleUrl(locale, 'privacy')} class="text-amber mt-8 inline-block font-bold underline underline-offset-4">
          {c.link} →
        </a>
      </div>
    </div>

    <!-- The rolling memory: the old footage fades out on the left, the seconds before the trigger stay saved, and the trigger is the white line. -->
    <div class="reveal mt-10 sm:mt-12">
      <div class="timeline" role="img" aria-label={c.timeline.label}>
        <div class="timeline__past"><div class="timeline__ticks"></div></div>
        <div class="timeline__kept"></div>
        <div class="timeline__playhead"></div>
        <div class="timeline__future"><div class="timeline__ticks"></div></div>
      </div>
      <div class="mt-3 grid grid-cols-[1fr_1.5fr_0.9fr] gap-3 text-xs font-semibold sm:grid-cols-3 sm:text-sm">
        <span class="text-muted">{c.timeline.old}</span>
        <b class="text-amber text-center font-bold">{c.timeline.kept}</b>
        <span class="text-muted text-right">{c.timeline.trigger}</span>
      </div>
    </div>
  </div>
</section>
