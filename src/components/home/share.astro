---
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = homeCopy[locale].share;

// A QR code drawn for the picture only (it opens nothing): a fixed pattern with the three corner squares.
const size = 21;
const finder = (x: number, y: number) => x < 7 && y < 7;
const isFinder = (x: number, y: number) => finder(x, y) || finder(size - 1 - x, y) || finder(x, size - 1 - y);
const cells: { x: number; y: number }[] = [];
for (let y = 0; y < size; y++) {
  for (let x = 0; x < size; x++) {
    if (isFinder(x, y)) continue;
    if ((x * 7 + y * 13 + ((x * y) % 5)) % 3 === 0) cells.push({ x, y });
  }
}
const corners = [
  [0, 0],
  [size - 7, 0],
  [0, size - 7],
];
const stroke = { fill: 'none', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

<section id="share" class="mx-auto max-w-6xl scroll-mt-8 px-4 py-16 sm:px-6 sm:py-24">
  <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div>
      <p class="text-amber reveal text-xs font-bold tracking-[0.24em] uppercase sm:text-sm">{c.eyebrow}</p>
      <h2 class="reveal mt-3 text-4xl font-extrabold sm:text-5xl lg:text-6xl">{c.title}</h2>
      <p class="text-muted reveal mt-5 max-w-lg text-lg">{c.subtitle}</p>
      <ul class="mt-8 grid gap-3">
        {
          c.bullets.map((b) => (
            <li class="reveal flex items-start gap-3 font-semibold">
              <svg viewBox="0 0 24 24" class="text-amber mt-0.5 size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 12.5 4.5 4.5L19 7.5" />
              </svg>
              {b}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- The app's link panel (ShareLinkPanel): the QR code, what the link holds, how long it lasts, Copiar and Enviar link. -->
    <div class="reveal flex justify-center lg:justify-end" aria-hidden="true">
      <div class="share-card">
        <div class="share-card__qr">
          <svg viewBox={`-1 -1 ${size + 2} ${size + 2}`} shape-rendering="crispEdges">
            <rect x="-1" y="-1" width={size + 2} height={size + 2} fill="#fff"></rect>
            {cells.map((cell) => <rect x={cell.x} y={cell.y} width="1" height="1" fill="#0A0A0A" />)}
            {
              corners.map(([x, y]) => (
                <g>
                  <rect x={x} y={y} width="7" height="7" fill="#0A0A0A" />
                  <rect x={x + 1} y={y + 1} width="5" height="5" fill="#fff" />
                  <rect x={x + 2} y={y + 2} width="3" height="3" fill="#0A0A0A" />
                </g>
              ))
            }
          </svg>
        </div>
        <p class="share-card__label">{c.card.label}</p>
        <p class="share-card__meta">
          <span>{c.card.clips}</span>
          <span class="share-card__dot"></span>
          <span class="text-amber">{c.card.hours}</span>
        </p>
        <div class="share-card__actions">
          <span class="share-card__button">
            <svg viewBox="0 0 24 24" stroke="currentColor" {...stroke}><rect x="8" y="8" width="12" height="12" rx="2.5"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
            {c.card.copy}
          </span>
          <span class="share-card__button share-card__button--main">
            <svg viewBox="0 0 24 24" stroke="currentColor" {...stroke}><path d="M12 15V3M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path></svg>
            {c.card.send}
          </span>
        </div>
        <p class="share-card__pro"><b>PRO</b> {c.card.pro}</p>
      </div>
    </div>
  </div>
</section>
