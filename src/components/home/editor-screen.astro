---
import PhoneVideo from './phone-video.astro';
import type { HomeCopy } from '../../i18n/home';

/**
 * The app's clip edit mode with Modo Foco open (ClipEdit, FocusPanel, TrimBar and ToolBar in the reprize app). Texts
 * come from the app's own catalogs; the icons are the app's (components/icons.tsx).
 */
interface Props {
  copy: HomeCopy['editor']['screen'];
}

const { copy } = Astro.props;
const stroke = { fill: 'none', 'stroke-width': '1.8', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

<div class="edit" aria-hidden="true">
  <div class="edit__top">
    <span class="edit__cancel">{copy.cancel}</span>
    <span class="edit__title">{copy.title}</span>
    <span class="edit__done">{copy.done}</span>
  </div>

  <div class="edit__stage">
    <PhoneVideo name="beach-tennis-editor" />
  </div>

  <div class="edit__panel">
    <div class="edit__head">
      <div class="edit__head-text">
        <span class="edit__panel-title">{copy.focusTitle}</span>
        <span class="edit__hint">{copy.focusHint}</span>
      </div>
      <span class="edit__switch"><i></i></span>
    </div>
    <div class="edit__note">{copy.focusHold}</div>
  </div>

  <div class="edit__cut">
    <div class="edit__labels">
      <span>{copy.trimBefore}</span>
      <b>{copy.trimCut}</b>
      <span>{copy.trimTrigger}</span>
    </div>
    <div class="edit__trimrow">
      <span class="edit__iconbtn">
        <svg viewBox="0 0 24 24" stroke="#fff" {...stroke} stroke-width="3"><path d="M8 5v14M16 5v14"></path></svg>
      </span>
      <div class="edit__trim">
        <div class="edit__window"></div>
        <div class="edit__playhead"></div>
        <span class="edit__grip edit__grip--start"></span>
        <span class="edit__grip edit__grip--end"></span>
      </div>
    </div>
  </div>

  <div class="edit__tools">
    <div class="edit__tool edit__tool--on">
      <span class="edit__tool-icon">
        <svg viewBox="0 0 24 24" stroke="#0A0A0A" {...stroke}>
          <path d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"></path><circle cx="12" cy="12" r="3"></circle>
        </svg>
      </span>
      {copy.tools.focus}
    </div>
    <div class="edit__tool">
      <span class="edit__tool-icon">
        <svg viewBox="0 0 24 24" stroke="#fff" {...stroke}><path d="M4 16a8 8 0 1 1 16 0M12 16l4-5"></path></svg>
      </span>
      {copy.tools.speed}
    </div>
    <div class="edit__tool">
      <span class="edit__tool-icon">
        <svg viewBox="0 0 24 24" stroke="#fff" {...stroke}><path d="M4 10v4h4l5 4V6L8 10zM16.5 9a4 4 0 0 1 0 6"></path></svg>
      </span>
      {copy.tools.sound}
    </div>
    <div class="edit__tool">
      <span class="edit__tool-icon">
        <svg viewBox="0 0 24 24" stroke="#fff" {...stroke}>
          <circle cx="11" cy="11" r="6"></circle><path d="M20 20l-4.5-4.5M11 8v6M8 11h6"></path>
        </svg>
      </span>
      {copy.tools.zoom}
    </div>
    <div class="edit__tool">
      <span class="edit__tool-icon">
        <svg viewBox="0 0 24 24" stroke="#fff" {...stroke}><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5"></path></svg>
      </span>
      {copy.tools.rotate}
    </div>
  </div>
</div>
